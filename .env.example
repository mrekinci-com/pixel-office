# Compose settings. Passwords remain in each service’s own .env file.
PIKSEL_OFIS_TUDUDI_IMAGE=pixel-office-tududi:0.87-po.3
# Empty binds only to this host. When a numeric private-network IP is supplied,
# scripts/install.sh creates a local Compose override for the additional port.
# Do not use 0.0.0.0 or a public IP address.
OFIS_PRIVATE_IP=
