# Put real values only in .env; never commit them.
OFIS_OWNER_PASSWORD=
# Hex encoding of 32 random bytes: 64 characters.
OFIS_SECRET_KEY=
OFIS_DATA_DIR=./data
PORT=9400
OFIS_COOKIE_SECURE=false
# Public origin behind an HTTPS reverse proxy; leave empty for direct local HTTP.
OFIS_PUBLIC_URL=
TUDUDI_BASE_URL=http://127.0.0.1:9393
# For test offices: deneme.piksel-ofis.local
TUDUDI_EMAIL_DOMAIN=piksel-ofis.local
TUDUDI_ADMIN_EMAIL=
TUDUDI_ADMIN_PASSWORD=

# Shared with the runner, at least 32 random characters. Empty disables real runs.
OFIS_RUNNER_KEY=

# Separate proxy at the same numeric private-network address. Empty uses encrypted credential display.
TUDUDI_PUBLIC_URL=
