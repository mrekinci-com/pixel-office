OFIS_URL=http://127.0.0.1:9400
OFIS_RUNNER_KEY=
# Use an absolute path to a new directory dedicated to this runner.
OFIS_WORK_DIR=
# Colon-separated allowed folder roots. Empty means no folder links.
OFIS_ALLOWED_ROOTS=
# Additional protected absolute paths, separated by colons. System, repository and work roots are already protected.
OFIS_PROTECTED_ROOTS=
OFIS_CONCURRENCY=2
OFIS_CODEX_MODEL=gpt-6.1-sol
# Keep credentials in private files; personal settings directories are never copied.
# If empty, use <OFIS_WORK_DIR>/.auth/claude-login/.credentials.json.
OFIS_CLAUDE_AUTH_FILE=
OFIS_CODEX_AUTH_FILE=
OFIS_CLAUDE_BIN=claude
OFIS_CODEX_BIN=codex
OFIS_BWRAP_BIN=bwrap
# Set to 1 only for real smoke checks; leave disabled for normal use.
OFIS_SMOKE=0

# Comma-separated models available to the account; no automatic account discovery.
OFIS_CODEX_MODELS=gpt-6.1-sol
OFIS_CLAUDE_MODELS=sonnet,opus,haiku
